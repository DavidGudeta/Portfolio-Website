{
  "entities": {
    "Property": {
      "title": "Property",
      "description": "A luxury real estate property listing.",
      "type": "object",
      "properties": {
        "title": { "type": "string", "description": "The name of the property." },
        "location": { "type": "string", "description": "The geographical location." },
        "price": { "type": "string", "description": "The listing price." },
        "beds": { "type": "integer", "description": "Number of bedrooms." },
        "baths": { "type": "integer", "description": "Number of bathrooms." },
        "sqft": { "type": "string", "description": "Square footage." },
        "image": { "type": "string", "description": "Main property image URL." },
        "description": { "type": "string", "description": "Detailed property description." },
        "amenities": { "type": "array", "items": { "type": "string" }, "description": "List of property amenities." },
        "gallery": { "type": "array", "items": { "type": "string" }, "description": "Additional property images." },
        "createdAt": { "type": "string", "format": "date-time", "description": "Creation timestamp." },
        "updatedAt": { "type": "string", "format": "date-time", "description": "Last update timestamp." }
      },
      "required": ["title", "location", "price", "beds", "baths", "sqft", "image", "description"]
    },
    "User": {
      "title": "User",
      "description": "A user profile with role-based access.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "description": "The unique user ID from Firebase Auth." },
        "email": { "type": "string", "format": "email", "description": "The user's email address." },
        "role": { "type": "string", "enum": ["admin", "client"], "description": "The user's role." },
        "createdAt": { "type": "string", "format": "date-time", "description": "Creation timestamp." }
      },
      "required": ["uid", "email", "role"]
    },
    "Inquiry": {
      "title": "Inquiry",
      "description": "A contact or viewing inquiry from a client.",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "phone": { "type": "string" },
        "date": { "type": "string" },
        "notes": { "type": "string" },
        "propertyId": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["name", "email", "phone"]
    },
    "AboutContent": {
      "title": "About Content",
      "description": "Content for the About section.",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "subtitle": { "type": "string" },
        "description": { "type": "string" },
        "image": { "type": "string" },
        "stats": { "type": "array", "items": { "type": "object", "properties": { "label": { "type": "string" }, "value": { "type": "string" } } } }
      }
    },
    "SiteSettings": {
      "title": "Site Settings",
      "description": "Global site configuration.",
      "type": "object",
      "properties": {
        "siteName": { "type": "string" },
        "contactEmail": { "type": "string" },
        "contactPhone": { "type": "string" },
        "socialLinks": { "type": "object" }
      }
    },
    "Testimonial": {
      "title": "Testimonial",
      "description": "A client testimonial or review.",
      "type": "object",
      "properties": {
        "name": { "type": "string", "description": "Client's name." },
        "role": { "type": "string", "description": "Client's role or designation." },
        "content": { "type": "string", "description": "The testimonial text." },
        "rating": { "type": "integer", "description": "Rating out of 5." },
        "image": { "type": "string", "description": "Client's photo URL." },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["name", "content", "rating"]
    }
  },
  "firestore": {
    "/properties/{propertyId}": {
      "schema": "Property",
      "description": "Collection of property listings."
    },
    "/testimonials/{testimonialId}": {
      "schema": "Testimonial",
      "description": "Collection of client testimonials."
    },
    "/users/{userId}": {
      "schema": "User",
      "description": "Collection of user profiles."
    },
    "/inquiries/{inquiryId}": {
      "schema": "Inquiry",
      "description": "Collection of client inquiries."
    },
    "/content/about": {
      "schema": "AboutContent",
      "description": "Singleton document for About section content."
    },
    "/settings/global": {
      "schema": "SiteSettings",
      "description": "Singleton document for global site settings."
    }
  }
}
